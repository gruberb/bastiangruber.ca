<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href={{ page.url | url | absoluteUrl(site.url) }}>
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title="Feed">

    {% bundledcss %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <script>
      // Runs before first paint so a saved theme choice doesn't flash the default.
      try { var theme = localStorage.getItem("theme"); if (theme) document.documentElement.dataset.theme = theme; } catch (e) {}
    </script>
    <title>{{ title | escape }}</title>

    <link rel="icon" type="image/png" href="/images/favicons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicons/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/images/favicons/site.webmanifest" />

    <link rel="me" href="https://hachyderm.io/@bastian">

    <script defer data-domain="bastiangruber.ca" src="https://analytics.novanexus.ca/js/script.js"></script>

    <meta property="og:title" content="{{  title or site.name | escape }}">
    <meta property="og:site_name" content="{{ site.name }}"/>
    <meta property="og:type" content="website"/>
    <meta property="og:url" content="{{ site.url + page.url }}"/>
    <meta name="twitter:card" content="summary_large_image">

    {% if site.author.twitterHandle %}
      <meta name="twitter:creator" content="@{{ site.author.twitterHandle | replace('@', '') }}"/>
    {% endif %}

    {% set desc = description %}
    {% if not desc %}
      {% set desc = content | striptags | truncate(140) %}
    {% endif %}
    {% if desc %}
      <meta name="description" content="{{ desc | escape  }}">
      <meta property="og:description" content="{{ desc | escape }}">
      <meta name="description" content="{{ desc | escape }}"/>
    {% endif %}

    {% if not socialImage %}
      {% set socialImage = site.defaultSocialImage %}
    {% endif %}
    {% if socialImage %}
      <meta property="og:image" content="{{ socialImage | url | absoluteUrl(site.url) }}"/>
      <meta name="twitter:image" content="{{ socialImage | url | absoluteUrl(site.url) }}"/>
    {% endif %}

    {# Add mermaid -- start #}
      <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
      <script>mermaid.initialize({startOnLoad:true});</script>
    {# Add mermaid -- end #}
  </head>
  <body>
    {%- set isPost = layout == "post" -%}
    {%- set section = "" -%}
    {%- for item in site.headerLinks -%}
      {%- if page.url.startsWith(item.url) -%}{%- set section = item.text -%}{%- endif -%}
    {%- endfor %}
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href="{{ '/' | url }}">
          <span class="brand__mark" aria-hidden="true">BG</span>
          <span class="brand__text">
            {%- if isPost %}
            <span class="mono-label">Blog · {{ page.date | readableDate }}</span>
            <span class="brand__title">{{ title }}</span>
            {%- elif page.url == "/" %}
            <span class="mono-label">{{ site.url | replace("https://", "") }}</span>
            <span class="brand__title">{{ site.name }}</span>
            {%- else %}
            <span class="mono-label">{{ site.name }}</span>
            <span class="brand__title">{{ section or title }}</span>
            {%- endif %}
          </span>
        </a>

        <nav class="nav" id="nav" aria-label="Main">
          {%- for item in site.headerLinks %}
          <a href="{{ item.url | url }}"
            {%- if page.url.startsWith(item.url) %} aria-current="page"{% endif %}
            {%- if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.text }}</a>
          {%- endfor %}
        </nav>

        <button class="iconbtn menubtn" id="menubtn" type="button" aria-label="Menu" aria-controls="nav" aria-expanded="false">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg>
        </button>
        <button class="iconbtn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 2a6 6 0 0 0 0 12z" fill="currentColor"/></svg>
        </button>
      </div>
      {%- if isPost %}
      <div class="progress" id="reading-progress"></div>
      {%- endif %}
    </header>

    <main id="main" class="{{ 'main--bleed' if fullBleed else 'main--page' }}">
      {{ content | safe }}
    </main>

    <footer class="footer">
      <div class="wrap">
        <span class="mono-label">© {% year %} {{ site.name }}</span>
        <ul>
          {%- for item in site.socialLinks.concat(site.footerLinks) %}
          <li><a href="{{ item.url | url }}"{% if item.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </div>
    </footer>

    {% bundledjs %}
  </body>
</html>
