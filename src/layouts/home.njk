---
layout: base
fullBleed: true
---
<section class="gridhero home-hero">
  <div class="wrap home-hero__grid">
    <div>
      <span class="chip">Staff Software Engineer · Mozilla</span>
      <h1>{{ site.name }}</h1>
      <div class="lede">{{ content | safe }}</div>
      <dl class="facts">
        <div>
          <dt class="mono-label">Book</dt>
          <dd><a href="https://rustwebdevelopment.com" target="_blank" rel="noopener">Rust Web Development</a><span class="sep">·</span>Manning, 2nd ed. in progress</dd>
        </div>
        <div>
          <dt class="mono-label">Find me</dt>
          <dd>
            {%- for item in site.socialLinks %}{% if item.text != "Book" %}
            {%- if not loop.first %}<span class="sep">·</span>{% endif -%}
            <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.text }}</a>
            {%- endif %}{% endfor -%}
          </dd>
        </div>
        <div>
          <dt class="mono-label">Résumé</dt>
          <dd><a href="{{ '/cv/' | url }}">View CV</a></dd>
        </div>
      </dl>
    </div>

    <div class="codecard" aria-hidden="true">
      <div class="codecard__head"><span class="mono-label">src/main.rs</span><span class="mono-label">Rust</span></div>
      <pre class="codecard__code"><span class="ln">1</span><span class="k">use</span> axum::{response::<span class="t">Json</span>, routing::get, <span class="t">Router</span>};
<span class="ln">2</span>
<span class="ln">3</span><span class="k">async fn</span> <span class="f">hello</span>() -&gt; <span class="t">Json</span>&lt;&amp;<span class="k">'static</span> <span class="t">str</span>&gt; {
<span class="ln">4</span>    <span class="t">Json</span>(<span class="s">"Building with Rust!"</span>)
<span class="ln">5</span>}
<span class="ln">6</span>
<span class="ln">7</span><span class="c">// "Building with Rust!" 🦀</span></pre>
    </div>
  </div>
</section>

<section class="wrap section">
  <div class="section__head">
    <h2>Recent writing</h2>
    <a href="{{ '/blog/' | url }}">All posts →</a>
  </div>
  <div class="rows">
    {%- for post in collections.posts | head(-4) | reverse %}
    {% include "post-row.njk" %}
    {%- endfor %}
  </div>
</section>

<section class="wrap section section--flush">
  <div class="section__head"><h2>Beyond the blog</h2></div>
  <div class="tiles">
    <a class="tile" href="{{ '/talks/' | url }}">
      <span class="mono-label">Talks &amp; Interviews</span>
      <h3>Speaking</h3>
      <p>Podcasts, videos and conference talks about Rust, web development and freelancing.</p>
      <span class="tile__go">View talks →</span>
    </a>
    <a class="tile" href="{{ '/projects/' | url }}">
      <span class="mono-label">Side Projects</span>
      <h3>Tools I built for myself</h3>
      <p>Brag Frog, WorkLedger, When Should I Go To The Beach? and other small, focused apps.</p>
      <span class="tile__go">View projects →</span>
    </a>
    <a class="tile" href="https://rustwebdevelopment.com" target="_blank" rel="noopener">
      <span class="mono-label">Book</span>
      <h3>Rust Web Development</h3>
      <p>Building production web services in Rust, published by Manning.</p>
      <span class="tile__go">rustwebdevelopment.com ↗</span>
    </a>
  </div>
</section>
